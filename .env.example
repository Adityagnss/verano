# VERANO_TRAFFIC_SCORE_BATCH=200
# VERANO_TRAFFIC_PROCESS_INTERVAL_S=60
# VERANO_TRAFFIC_ALERT_TIMEOUT_S=10.0
# VERANO_TRAFFIC_SMTP_HOST=
# VERANO_TRAFFIC_SMTP_PORT=587
# VERANO_TRAFFIC_SMTP_USER=
# VERANO_TRAFFIC_SMTP_PASSWORD=
# VERANO_TRAFFIC_SMTP_FROM=
# VERANO_TRAFFIC_SMTP_STARTTLS=true
# VERANO_SMTP_TIMEOUT_S=10.0
# VERANO_SECURITY_DEFAULT_PER_CATEGORY=10
# VERANO_SECURITY_MAX_PER_CATEGORY=36
# VERANO_IMPROVE_ROUNDS=3
# VERANO_IMPROVE_MAX_ROUNDS=6
