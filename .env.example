# VERANO_IMPROVE_SURVIVORS=2
# VERANO_IMPROVE_TARGET_EFFECT=0.1
# VERANO_IMPROVE_QUICK_MIN_CASES=8
# VERANO_IMPROVE_QUICK_MAX_CASES=40
# VERANO_CLUSTER_MAX_CLUSTERS=24
# VERANO_CLUSTER_SIMILARITY=0.6
# VERANO_CLUSTER_BATCH_SIZE=200
# VERANO_CLUSTER_EXAMPLES_PER_CLUSTER=5
