# Verano configuration. Copy to .env (`make env` does this and generates the two secrets).
# Every setting in backend/app/core/config.py is listed here with its default.
# Settings use the VERANO_ prefix; OLLAMA_BASE_URL is also read without it.

# --- Secrets (required; `make env` fills them) --------------------------------------------
# Fernet keys that encrypt provider API keys. Comma-separated: the first encrypts, all decrypt.
VERANO_MASTER_KEYS=
# Secret that signs access tokens (HS256). Use at least 32 random bytes.
VERANO_JWT_SECRET=
# Postgres password used by docker-compose for the bundled database.
POSTGRES_PASSWORD=verano

# --- Docker Compose edge (Caddy is the only entry point, ADR 0006) ------------------------
# Where Caddy listens. ":80" = plain HTTP at http://localhost:<VERANO_HTTP_PORT>, no
# certificates. Set a real domain (e.g. verano.example.com) and Caddy gets HTTPS
# certificates automatically; then publish 80 and 443 below.
VERANO_SITE_ADDRESS=:80
# Host ports Caddy is published on.
VERANO_HTTP_PORT=8080
VERANO_HTTPS_PORT=8443
# Private Docker network and Caddy's fixed address on it (the backend trusts only this).
VERANO_DOCKER_SUBNET=172.28.0.0/24
CADDY_ADDRESS=172.28.0.250

# --- Application ------------------------------------------------------------------------
# Product name shown in the API docs.
VERANO_APP_NAME=Verano
# development or production. In production, a non-Secure refresh cookie and the mock
# provider are refused at startup.
VERANO_ENVIRONMENT=development
# Prefix every API route is mounted under.
VERANO_API_PREFIX=/api/v1
# Extra browser origins allowed to call the API (JSON list). The UI is served from the same
# origin through Caddy, so this is only needed if another site calls the API directly.
VERANO_CORS_ORIGINS=[]
# Log level for the JSON logs.
VERANO_LOG_LEVEL=INFO
# Regexes masked in every log line, as a second defence behind "keys are never logged" (JSON list).
# VERANO_LOG_REDACT_PATTERNS=["sk-[A-Za-z0-9_\\-]{8,}", "AIza[0-9A-Za-z_\\-]{20,}", "gsk_[A-Za-z0-9]{8,}", "(?i)bearer\\s+[A-Za-z0-9._\\-]{8,}"]

# --- Data stores (docker-compose sets these for its containers) ------------------------
# Async SQLAlchemy URL of Postgres 16.
VERANO_DATABASE_URL=postgresql+asyncpg://verano:verano@localhost:5432/verano
# Connections kept open per process, and extra connections allowed under load.
VERANO_DB_POOL_SIZE=10
VERANO_DB_MAX_OVERFLOW=20
# Valkey URL (queue, rate limits, progress). The redis:// scheme is correct for Valkey.
VERANO_VALKEY_URL=redis://localhost:6379/0

# --- Auth --------------------------------------------------------------------------------
# JWT signing algorithm for access tokens.
VERANO_JWT_ALGORITHM=HS256
# Access token lifetime (seconds). The frontend keeps it in memory only.
VERANO_ACCESS_TOKEN_TTL_S=900
# Refresh token lifetime (seconds). Rotated on every use.
VERANO_REFRESH_TOKEN_TTL_S=2592000
# Name of the httpOnly refresh-token cookie.
VERANO_REFRESH_COOKIE_NAME=verano_refresh
# Mark the refresh cookie Secure (sent over HTTPS only). Keep true whenever Verano is served
# over HTTPS. Safari/WebKit does not send Secure cookies to plain http://localhost, so
# `make env` sets this to false for local HTTP use; production refuses false.
VERANO_REFRESH_COOKIE_SECURE=true
# Minimum password length.
VERANO_PASSWORD_MIN_LENGTH=10
# Allow anyone to sign up. When false, only the first account can be created.
VERANO_ALLOW_SIGNUP=true
# Auth throttling: window length (seconds) and attempts allowed per window per IP / per email.
VERANO_AUTH_RATE_WINDOW_S=60
VERANO_AUTH_RATE_LIMIT_PER_IP=20
VERANO_AUTH_RATE_LIMIT_PER_EMAIL=5
# Reverse proxies (addresses or CIDR ranges, JSON list) whose X-Forwarded-For header is
# trusted for the client IP. docker-compose sets this to Caddy's address; outside Compose,
# list only your own proxy's address, never a whole public range.
VERANO_TRUSTED_PROXIES=[]
# Name given to the personal workspace created at sign-up; {name} is the user's name.
VERANO_PERSONAL_ORG_NAME_TEMPLATE={name}'s workspace

# --- API ---------------------------------------------------------------------------------
# Page size when a list request doesn't ask for one, and the largest page allowed.
VERANO_PAGINATION_DEFAULT_LIMIT=50
VERANO_PAGINATION_MAX_LIMIT=200

# --- Providers ---------------------------------------------------------------------------
# Where Ollama is reached. Default: the Ollama running on the host, seen from a container.
# `make up-local` overrides it to the bundled container (http://ollama:11434).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Timeout (seconds) for provider listing / validation requests.
VERANO_PROVIDER_HTTP_TIMEOUT_S=15.0
# Data files; defaults are the files shipped in backend/app/modules/.
# VERANO_PROVIDERS_PATH=
# VERANO_MODEL_OVERRIDES_PATH=

# --- Mock provider (development and tests only) ----------------------------------------
# Offer the fake `mock` provider. Never enable in production.
VERANO_MOCK_PROVIDER_ENABLED=false
# Mock model definitions, scripted replies and answer key; defaults ship in gateway/config/.
# VERANO_MOCK_MODELS_PATH=
# VERANO_MOCK_SCRIPTED_DIR=
# VERANO_MOCK_ANSWER_KEY_PATH=

# --- LLM gateway -------------------------------------------------------------------------
# Timeout (seconds) for one model call attempt.
VERANO_LLM_TIMEOUT_S=60.0
# Total attempts per call (first try + retries) for 429 / 5xx / timeouts / connection errors.
VERANO_LLM_MAX_ATTEMPTS=3
# Exponential backoff base and cap (seconds); jitter is applied on top.
VERANO_LLM_BACKOFF_BASE_S=0.5
VERANO_LLM_BACKOFF_MAX_S=30.0
# Extra attempts complete_json makes, sending back the validation error.
VERANO_JSON_REPAIR_ATTEMPTS=1
# Characters per token used to estimate a request's size for the token bucket.
VERANO_TOKEN_ESTIMATE_CHARS_PER_TOKEN=4

# --- Prompt Studio --------------------------------------------------------------------
# Longest system or user template accepted, in characters.
VERANO_PROMPT_TEMPLATE_MAX_CHARS=200000

# --- Uploads, files and progress (Phase 2) ------------------------------------------------
# Where uploaded files are stored: the storage backend and, for `local`, its folder.
# docker-compose stores them in the `verano_files` volume at /srv/data.
VERANO_STORAGE_BACKEND=local
# VERANO_STORAGE_ROOT=
# Largest upload accepted (bytes) and most rows a rows file may have.
VERANO_UPLOAD_MAX_BYTES=100000000
VERANO_UPLOAD_MAX_ROWS=200000
# A single file's parsing stops after this many seconds; the worker kills it this much later.
VERANO_FILE_PARSE_TIMEOUT_S=300.0
VERANO_JOB_HARD_LIMIT_GRACE_S=30.0
# Largest single CSV cell, in characters.
VERANO_CSV_FIELD_MAX_CHARS=1000000
# Zip-based files (XLSX, DOCX): most uncompressed bytes, most internal parts, and the
# largest expansion ratio of one part before it is treated as a zip bomb.
VERANO_ZIP_MAX_UNCOMPRESSED_BYTES=1000000000
VERANO_ZIP_MAX_ENTRIES=10000
VERANO_ZIP_MAX_RATIO=200.0
# Reference documents: most pages (PDF), most characters of text, and the size of one section.
VERANO_DOCUMENT_MAX_PAGES=500
VERANO_DOCUMENT_MAX_CHARS=5000000
VERANO_DOCUMENT_SECTION_MAX_CHARS=3000
# Sample rows shown for column mapping, and row numbers listed per validation issue.
VERANO_PROFILE_SAMPLE_ROWS=20
VERANO_REPORT_MAX_LISTED_ROWS=100
# Rows written per database batch during import, and rows between progress updates.
VERANO_IMPORT_BATCH_SIZE=1000
VERANO_PROGRESS_EVERY_ROWS=2000
# How long a job's latest progress is kept (seconds), and the SSE keepalive interval.
VERANO_PROGRESS_TTL_S=86400
VERANO_SSE_KEEPALIVE_S=15.0
# Category given to real rows without a category column, and the dataset's default name.
VERANO_DATASET_DEFAULT_CATEGORY=happy_path
VERANO_DATASET_DEFAULT_NAME=Test cases
# Share of cases held out on approval, and the holdout size below which Improve warns.
VERANO_DATASET_HOLDOUT_RATIO=0.3
VERANO_DATASET_MIN_HOLDOUT=30

# --- Eval Generator ------------------------------------------------------------------------
# Default dataset size (20-1000 can be chosen), cases asked for per generator call, real
# rows shown as style examples, rows shown when drafting the Task Spec, document sections
# used for grounding (and characters per section), cases per answer-drafting call, top-up
# rounds for short categories, and the job's time limit.
VERANO_GENERATOR_DEFAULT_SIZE=100
VERANO_GENERATOR_BATCH_SIZE=10
VERANO_GENERATOR_EXAMPLE_ROWS=5
VERANO_GENERATOR_TASK_SPEC_ROWS=10
VERANO_GENERATOR_MAX_SECTIONS=8
VERANO_GENERATOR_SECTION_CHARS=1500
VERANO_GENERATOR_ANSWER_BATCH_SIZE=20
VERANO_GENERATOR_TOP_UP_ROUNDS=2
VERANO_GENERATOR_TIMEOUT_S=3600.0
# Near-duplicate removal: fastembed (local model, downloaded once into the cache dir) or
# lexical (no model, catches near-identical wording only); cases above this cosine
# similarity are dropped.
VERANO_EMBEDDER=fastembed
VERANO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# VERANO_EMBEDDING_CACHE_DIR=
VERANO_DEDUPE_SIMILARITY=0.92

# --- Adaptive rate limits ------------------------------------------------------------------
# Multiply the current rate by this after a 429.
VERANO_RATE_LIMIT_DECREASE_FACTOR=0.5
# After each success, grow the rate by this fraction of the ceiling.
VERANO_RATE_LIMIT_INCREASE_FRACTION=0.05
# Never drop below this fraction of the ceiling.
VERANO_RATE_LIMIT_FLOOR_FRACTION=0.05
# Give up (429) if a call would wait longer than this (seconds) for a slot.
VERANO_RATE_LIMIT_ACQUIRE_TIMEOUT_S=120.0
# How long learned limits are remembered after the last call (seconds).
VERANO_RATE_LIMIT_STATE_TTL_S=3600
